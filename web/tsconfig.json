{
  // Nur zur Typpruefung (`npm run typecheck`). Gebaut wird hier nichts: Node fuehrt die
  // TypeScript-Dateien seit Version 23.6 direkt aus, indem es die Typangaben beim Laden
  // entfernt. Deshalb `noEmit` und `verbatimModuleSyntax`.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    // `erasableSyntaxOnly` verbietet TypeScript-Konstrukte, die beim Laden nicht einfach
    // weggestrichen werden koennen (etwa `enum` oder Parameter-Eigenschaften) — genau die
    // kann Node nicht ausfuehren.
    "erasableSyntaxOnly": true,
    // Node laedt die Dateien MIT `.ts`-Endung; TypeScript erlaubt das nur zusammen mit `noEmit`.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
